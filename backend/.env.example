DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=ds_chapter_tracker

JWT_SECRET=your_jwt_secret

# GitHub API (Personal Access Token) — needed for GitHub tracking
# Leave empty to use unauthenticated requests (60/hr limit)
GITHUB_TOKEN=

# SMTP email (Gmail)
# Use an App Password, not your account password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend URL (used for password reset links)
FRONTEND_URL=http://localhost:5173